<?xml version="1.0"?>
<package format="3">
  <name>race_ego_bridge</name>
  <version>0.1.0</version>
  <description>Coordinate, map, goal, trajectory and safety adapters for EGO-Planner and PX4.</description>
  <maintainer email="3334023519@qq.com">utsl</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>race_msgs</depend>
  <depend>quadrotor_msgs</depend>
  <depend>traj_utils</depend>
  <depend>bspline_opt</depend>
  <depend>pcl_conversions</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>plan_env</depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
