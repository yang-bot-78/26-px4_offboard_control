Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: false
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: false
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.8
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 210; 210; 210
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 255
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: Saved Map
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.04
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Transient Local
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /saved_map
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Alpha: 0.60
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 90; 255
          Color Transformer: FlatColor
          Decay Time: 0.75
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 255
          Min Color: 0; 0; 0
          Name: EGO Fused Obstacle Input
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 3
          Size (m): 0.05
          Style: Flat Squares
          Topic:
            Depth: 2
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /race/ego/cloud
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 60; 255; 100
          Color Transformer: FlatColor
          Decay Time: 0.35
          Enabled: false
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 255
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: FAST-LIO Scan (diagnostic, camera_init)
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.04
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /cloud_registered
          Use Fixed Frame: true
          Use rainbow: false
          Value: false
        - Angle Tolerance: 0.1
          Class: rviz_default_plugins/Odometry
          Covariance:
            Orientation:
              Alpha: 0.5
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: false
            Position:
              Alpha: 0.3
              Color: 204; 51; 204
              Scale: 1
              Value: false
            Value: false
          Enabled: true
          Keep: 1
          Name: Vehicle Odom
          Position Tolerance: 0.1
          Shape:
            Alpha: 1
            Axes Length: 0.8
            Axes Radius: 0.06
            Color: 0; 170; 255
            Head Length: 0.3
            Head Radius: 0.1
            Shaft Length: 0.8
            Shaft Radius: 0.05
            Value: Arrow
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 2
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /race/odom
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 170; 0
          Enabled: true
          Head Diameter: 0.18
          Head Length: 0.12
          Length: 0.2
          Line Style: Lines
          Line Width: 0.06
          Name: Raw A-star Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 170; 0
          Pose Style: None
          Radius: 0.04
          Shaft Diameter: 0.04
          Shaft Length: 0.08
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /race/super_planner/raw_path
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 0; 255; 255
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Lines
          Line Width: 0.1
          Name: Smoothed Tracking Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 0; 255; 255
          Pose Style: None
          Radius: 0.05
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /rm_mpc_trajectory_vis_path
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: false
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /race/super_planner/debug_markers
          Name: Super Inflated Costmap and Footprint
          Namespaces: {}
          Queue Size: 100
          Value: false
        - Class: rviz_common/Group
          Displays:
            - Alpha: 0.75
              Autocompute Intensity Bounds: true
              Autocompute Value Bounds:
                Max Value: 10
                Min Value: -10
                Value: true
              Axis: Z
              Channel Name: intensity
              Class: rviz_default_plugins/PointCloud2
              Color: 255; 60; 60
              Color Transformer: FlatColor
              Decay Time: 0.5
              Enabled: true
              Invert Rainbow: false
              Max Color: 255; 255; 255
              Max Intensity: 255
              Min Color: 0; 0; 0
              Min Intensity: 0
              Name: EGO Inflated No-Fly Volume
              Position Transformer: XYZ
              Selectable: false
              Size (Pixels): 3
              Size (m): 0.04
              Style: Flat Squares
              Topic:
                Depth: 2
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /race/ego/occupancy_inflate
              Use Fixed Frame: true
              Use rainbow: false
              Value: true
            - Alpha: 1
              Buffer Length: 1
              Class: rviz_default_plugins/Path
              Color: 0; 255; 80
              Enabled: true
              Head Diameter: 0.2
              Head Length: 0.15
              Length: 0.2
              Line Style: Lines
              Line Width: 0.1
              Name: Legacy Validated B-spline Preview (duplicate)
              Offset:
                X: 0
                Y: 0
                Z: 0
              Pose Color: 0; 255; 80
              Pose Style: None
              Radius: 0.04
              Shaft Diameter: 0.05
              Shaft Length: 0.08
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /race/ego/path
              Value: false
            - Alpha: 0.9
              Buffer Length: 1
              Class: rviz_default_plugins/Path
              Color: 255; 200; 0
              Enabled: true
              Head Diameter: 0.15
              Head Length: 0.1
              Length: 0.15
              Line Style: Lines
              Line Width: 0.05
              Name: Validated Active B-spline Preview
              Offset:
                X: 0
                Y: 0
                Z: 0
              Pose Color: 255; 200; 0
              Pose Style: None
              Radius: 0.03
              Shaft Diameter: 0.04
              Shaft Length: 0.06
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /race/ego/predicted_path
              Value: true
            - Alpha: 0.9
              Buffer Length: 1
              Class: rviz_default_plugins/Path
              Color: 40; 130; 255
              Enabled: true
              Head Diameter: 0.15
              Head Length: 0.1
              Length: 0.15
              Line Style: Lines
              Line Width: 0.04
              Name: Actual Vehicle Odom History (node lifetime)
              Offset:
                X: 0
                Y: 0
                Z: 0
              Pose Color: 40; 130; 255
              Pose Style: None
              Radius: 0.03
              Shaft Diameter: 0.04
              Shaft Length: 0.06
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /race/ego/actual_path
              Value: true
            - Class: rviz_default_plugins/Marker
              Enabled: true
              Name: Control Points
              Namespaces: {}
              Queue Size: 20
              Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /race/ego/control_points
              Value: true
            - Class: rviz_default_plugins/Marker
              Enabled: true
              Name: Current Setpoint
              Namespaces: {}
              Queue Size: 20
              Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /race/ego/setpoint
              Value: true
            - Class: rviz_default_plugins/Marker
              Enabled: true
              Name: Local Goal
              Namespaces: {}
              Queue Size: 20
              Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /race/ego/goal_marker
              Value: true
          Enabled: true
          Name: EGO Local Planner (shadow / astar_ego)
          Value: true
      Enabled: true
      Name: Visualization Switches
      Value: true
  Enabled: true
  Global Options:
    Background Color: 0; 0; 0
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.35
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.3
    Saved: ~
